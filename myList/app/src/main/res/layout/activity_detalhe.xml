<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp"
    android:visibility="visible"
    tools:context=".activities.DetalheActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_detalhe"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/abc_ic_ab_back_material" />

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="390dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/borda"
        android:backgroundTint="@color/azul_escuro"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toTopOf="@+id/button_linear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.49"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_detalhe">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal|center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/poster_linear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_poster"
                        android:layout_width="120dp"
                        android:layout_height="150dp"
                        android:layout_margin="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/icon" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/tipo_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rd_filme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Filme"
                        android:textColor="@color/white" />

                    <RadioButton
                        android:id="@+id/rd_serie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Série"
                        android:textColor="@color/white" />

                    <RadioButton
                        android:id="@+id/rd_livro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Livro"
                        android:textColor="@color/white" />

                    <RadioButton
                        android:id="@+id/rd_jogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Jogo"
                        android:textColor="@color/white" />

                </RadioGroup>

                <LinearLayout
                    android:id="@+id/edit_linear"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/et_titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:hint="Título"

                        android:inputType="text"
                        android:textColor="@color/white"
                        android:textColorHint="@color/cinza" />

                    <EditText
                        android:id="@+id/et_saga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:hint="Saga"

                        android:inputType="text"
                        android:textColor="@color/white"
                        android:textColorHint="@color/cinza"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/et_vol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:hint="Volume/Temporada"

                        android:inputType="text"
                        android:textColor="@color/white"
                        android:textColorHint="@color/cinza"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/et_comentario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:hint="Comentário"

                        android:inputType="text"
                        android:textColor="@color/white"
                        android:textColorHint="@color/cinza" />

                    <LinearLayout
                        android:id="@+id/data_linear"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_inicio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ems="10"
                            android:hint="Início"
                            android:inputType="date"
                            android:textColor="@color/white"

                            android:textColorHint="@color/cinza" />

                        <EditText
                            android:id="@+id/et_conclusao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ems="10"
                            android:hint="Conclusão"
                            android:inputType="date"
                            android:textColor="@color/white"

                            android:textColorHint="@color/cinza" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/status_linear"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textColor="@color/white" />

                    <RadioGroup
                        android:id="@+id/status_group"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rd_concluido"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="Concluído"
                            android:textColor="@color/white" />

                        <RadioButton
                            android:id="@+id/rd_largado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Largado"
                            android:textColor="@color/white" />
                    </RadioGroup>
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/format_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <RadioButton
                        android:id="@+id/rd_fisico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Físico"
                        android:textColor="@color/white" />

                    <RadioButton
                        android:id="@+id/rd_ebook"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ebook"
                        android:textColor="@color/white" />
                </RadioGroup>

                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:max="5" />

                <View
                    android:id="@+id/divider5"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?android:attr/listDivider" />

                <LinearLayout
                    android:id="@+id/linear_frase"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_frase"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ems="10"
                        android:hint="Frase"
                        android:inputType="text"
                        android:textColor="@color/white"
                        android:textColorHint="@color/cinza" />

                    <ImageButton
                        android:id="@+id/img_add"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:srcCompat="@drawable/add_icon" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/button_linear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <TextView
            android:id="@+id/txt_salvar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:layout_weight="1"
            android:text="Salvar"
            android:textColor="@color/azul_claro"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_excluir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:layout_weight="1"
            android:text="Excluir"
            android:textColor="#EB0606"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>